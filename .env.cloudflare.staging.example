# Copy to .env.cloudflare.staging.local only immediately before Checkpoint 15D-B.
# Account IDs are not credentials, but keeping this environment-specific value
# unversioned reduces the chance of deploying to the wrong Cloudflare account.
SMART_FINANCE_CLOUDFLARE_ENVIRONMENT=staging
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_STAGING_WORKER_NAME=smart-finance-staging

# Server-only Worker binding. Keep empty until the explicitly approved pilot activation.
# Comma-separated Auth user UUIDs; never commit real identities.
SMART_FINANCE_REMOTE_PILOT_USER_IDS=

# Do not add CLOUDFLARE_API_TOKEN here. The first controlled deployment uses
# Wrangler OAuth login; future CI credentials belong in the CI secret store.
