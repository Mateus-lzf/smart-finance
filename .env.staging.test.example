# Copy to .env.staging.test.local only for the explicit remote smoke test.
# Use two confirmed, disposable staging-only accounts. This ignored file must
# never contain personal accounts, production accounts, or financial data.
SMART_FINANCE_RUN_REMOTE_TESTS=I_UNDERSTAND_THIS_USES_STAGING
SMART_FINANCE_STAGING_TEST_USER_A_EMAIL=user-a@example.test
SMART_FINANCE_STAGING_TEST_USER_A_PASSWORD=replace-with-disposable-password
SMART_FINANCE_STAGING_TEST_USER_B_EMAIL=user-b@example.test
SMART_FINANCE_STAGING_TEST_USER_B_PASSWORD=replace-with-disposable-password
