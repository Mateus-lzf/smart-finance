# Browser-safe values. These are public by design and may be exposed in the client bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Sprint 14B1 deliberately has no secret/service-role variable. Normal application
# operations use the authenticated user's session and remain subject to RLS.
