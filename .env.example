# Public values. These may be exposed to the browser in a future Auth integration.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only privileged value. Never prefix it with VITE_ or expose it to client code.
# It is intentionally unused by the Smart Finance application in Sprint 14A.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
