# Local development only. Copy this file to .env.local and use the values
# reported by `supabase status` after `npm run db:start`.
#
# These two values are browser-safe by design and may be exposed in the client bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# The application deliberately has no secret/service-role/admin variable. Normal
# operations use the authenticated user's session and remain subject to RLS.
# Remote staging values belong in the ignored .env.staging.local file, never here.
