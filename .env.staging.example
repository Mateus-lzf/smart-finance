# Copy to .env.staging.local only after the dedicated staging project exists.
# Never put production values in this file or in .env.staging.local.
SMART_FINANCE_REMOTE_ENVIRONMENT=staging
SUPABASE_STAGING_PROJECT_REF=replace-with-staging-project-ref

# Browser-safe hosted values. The guard requires the URL project ref to match
# SUPABASE_STAGING_PROJECT_REF and accepts only a publishable sb_publishable_ key.
VITE_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-staging-publishable-key

# Server-only and disabled by default. Activation belongs to the controlled pilot checkpoint.
# Never commit real account identities or expose this value through a VITE_ variable.
SMART_FINANCE_REMOTE_PILOT_USER_IDS=
